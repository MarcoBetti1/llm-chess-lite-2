{
  "name": "llm-chess-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.9.3",
    "chess.js": "^1.4.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "openai": "^4.104.0",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.3",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
